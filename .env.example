# Copy to .env and put your Groq key here.
GROQ_API_KEY=your_groq_api_key_here

# Main answer model. Change without touching code.
GROQ_MODEL=openai/gpt-oss-120b

# Choose private credentials before starting the app.
# Replace every placeholder; the app refuses sign-in while any value is unchanged/empty.
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD=replace_with_strong_admin_password
EMPLOYEE_USERNAME=replace_with_employee_username
EMPLOYEE_PASSWORD=replace_with_strong_employee_password

# Required by the separate FastAPI backend. Generate a private value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=replace_with_random_secret_at_least_32_characters
# Comma-separated frontend origins allowed to call the API.
STRIVEN_CORS_ORIGINS=http://localhost:5173
